# PayPal Sandbox Configuration (Strictly Sandbox: https://api-m.sandbox.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id_here
# Optional build-time override; at runtime /api/config serves PAYPAL_CLIENT_ID automatically
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Google Cloud Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=global
LLM_MODEL=gemini-3.5-flash-lite
LLM_MODEL_ALT=gemini-3.8-flash
LLM_TIMEOUT_MS=15000
# Optional JSON service account key when not using Application Default Credentials (ADC) or Cloud Run service account
GOOGLE_CREDENTIALS_JSON=

# Application & Demo Mode Configuration
DEMO_MODE=1
HOSTED_DEMO=0
ALLOW_GLOBAL_RESET=0
DAILY_LLM_CALL_LIMIT=500
SQLITE_PATH=data.db
APP_BASE_URL=http://localhost:3000
DEBUG_HEADERS=0
