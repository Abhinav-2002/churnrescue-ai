# Required by the PayPal JS SDK on the client side\nNEXT_PUBLIC_PAYPAL_CLIENT_ID=\nPAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com # Use sandbox for testing
PAYPAL_WEBHOOK_ID=your_webhook_id_here # Optional, for webhook verification
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
LLM_MODEL=gemini-3.5-flash-lite
# Alternate model for comparison runs (scripts/try-agent.ts)
LLM_MODEL_ALT=gemini-3.8-flash
